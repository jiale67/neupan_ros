<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neupan_ros</name>
  <version>0.0.0</version>
  <description>ROS 2 wrapper of the NeuPAN planner for the wheeltec V550_mec robot</description>
  <maintainer email="han@todo.todo">han</maintainer>
  <license>GPL-3.0-or-later</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- 底盘 + 雷达由 turn_on_wheeltec_robot 单独启动，本包不依赖它 -->
  <!-- NeuPAN 本体是 pip 包（pip install -e NeuPAN），不是 ROS 包，这里不列 -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
